#!/bin/sh
# WHO-data gate — pre-commit: scan the STAGED file contents.
# The commit message is enforced by the companion commit-msg hook (a pre-commit
# hook cannot see the final message). Install both with:
#     git config core.hooksPath .githooks
# See tools/WHO-DATA-GATE.md. Bypassing this gate is forbidden.
set -e
ROOT="$(git rev-parse --show-toplevel)"
exec python3 "$ROOT/tools/who-data-gate.py" --staged --quiet
